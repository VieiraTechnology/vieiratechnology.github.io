::-webkit-scrollbar { width: 12px; }

::-webkit-scrollbar-track { background: rgb(241, 245, 249); }

::-webkit-scrollbar-thumb { background: rgb(59, 130, 246); border-radius: 6px; }

::-webkit-scrollbar-thumb:hover { background: rgb(37, 99, 235); }

.dark ::-webkit-scrollbar-track { background: rgb(30, 41, 59); }

.dark ::-webkit-scrollbar-thumb { background: rgb(59, 130, 246); }

.dark ::-webkit-scrollbar-thumb:hover { background: rgb(96, 165, 250); }

.max-h-\[400px\]::-webkit-scrollbar { width: 6px; }

.max-h-\[400px\]::-webkit-scrollbar-track { background: transparent; }

.max-h-\[400px\]::-webkit-scrollbar-thumb { background: rgb(203, 213, 225); border-radius: 3px; }

.dark .max-h-\[400px\]::-webkit-scrollbar-thumb { background: rgb(71, 85, 105); }

html, body { overflow-x: hidden; width: 100%; max-width: 100vw; }

:not(.osint-ad-banner):not(.osint-ad-banner *):not(.search-bar-container):not(.search-bar-container *) { max-width: 100%; box-sizing: border-box; }

.min-h-screen { min-height: 100vh; }

.line-clamp-3 { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }

* { transition: opacity 0.3s ease-in-out, transform 0.3s ease-in-out; }

@keyframes pageEnter { 
  0% { opacity: 0; transform: translateY(20px); }
  100% { opacity: 1; transform: translateY(0px); }
}

main { animation: 0.6s ease-out 0s 1 normal none running pageEnter; }

button, a { transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1); }

html { scroll-behavior: smooth; }

.prose h1 { text-align: center; margin-top: 3rem; margin-bottom: 2rem; font-weight: 800; font-size: 3rem !important; color: rgb(31, 41, 55) !important; }

.prose h2 { text-align: center; margin-top: 2.5rem; margin-bottom: 1.5rem; font-weight: 700; font-size: 2.5rem !important; color: rgb(55, 65, 81) !important; }

.prose h3 { text-align: center; margin-top: 2rem; margin-bottom: 1rem; font-weight: 600; font-size: 2rem !important; color: rgb(75, 85, 99) !important; }

.prose h4 { text-align: center; margin-top: 1.5rem; margin-bottom: 1rem; font-weight: 600; font-size: 1.5rem !important; color: rgb(107, 114, 128) !important; }

.prose p { margin-bottom: 1.5rem; line-height: 1.8; font-size: 1.125rem !important; color: rgb(55, 65, 81) !important; }

.prose ul, .prose ol { margin-bottom: 1.5rem; font-size: 1.125rem !important; }

.prose li { margin-bottom: 0.5rem; color: rgb(55, 65, 81) !important; }

.prose strong { color: rgb(31, 41, 55) !important; font-weight: 700; }

.dark .prose h1 { color: rgb(249, 250, 251) !important; }

.dark .prose h2 { color: rgb(243, 244, 246) !important; }

.dark .prose h3 { color: rgb(229, 231, 235) !important; }

.dark .prose h4, .dark .prose p, .dark .prose li { color: rgb(209, 213, 219) !important; }

.dark .prose strong { color: rgb(249, 250, 251) !important; }

