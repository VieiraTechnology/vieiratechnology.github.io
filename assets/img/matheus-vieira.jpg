.tawk-image { max-width: 100%; border-radius: 10px; }

.tawk-image-left { text-align: left; }

.tawk-image-right { text-align: right; }

.tawk-image-center { text-align: center; }

.tawk-image-loader, .tawk-image-loader::after { border-radius: 50%; width: 1.25rem; height: 1.25rem; }

.tawk-image-loader { margin: 1.25rem auto; font-size: 0.625rem; position: relative; text-indent: -9999rem; border-width: 5px; border-style: solid; border-color: rgb(33, 33, 33) rgb(33, 33, 33) rgb(33, 33, 33) rgb(84, 84, 84); border-image: initial; transform: translateZ(0px); animation: 1.1s linear 0s infinite normal none running load8; }

@keyframes load8 { 
  0% { transform: rotate(0deg); }
  100% { transform: rotate(1turn); }
}

.tawk-input-medium { height: 3.125rem; padding: 1rem 1.3rem; line-height: 3.125rem; font-size: 0.937rem; }

.tawk-form-wrapper .tawk-input.tawk-input-medium + .tawk-form-label { font-size: 0.937rem; transform: translateY(14px); }

.tawk-form-wrapper .tawk-input.tawk-input-medium + .tawk-form-label.tawk-active { transform: translateY(-0.625rem); }

.tawk-lists { font-size: 0.812rem; }

.tawk-list-item { padding: 1rem; }

a.tawk-list-item, button.tawk-list-item { background: transparent; width: 100%; text-align: left; display: block; border: 0px; }

a.tawk-list-item:hover, button.tawk-list-item:hover { cursor: pointer; color: var(--tawk-header-background-color); }

.tawk-list-header { font-size: 0.812rem; font-weight: 600; color: rgb(18, 18, 18); margin-bottom: 0px; padding: 0.6rem; }

.tawk-list-item.tawk-list-nested { padding-left: 1.3rem; }

.tawk-rtl .tawk-list-item.tawk-list-nested { padding-right: 1.3rem; }

.tawk-list-item-medium, .tawk-list-item-small, .tawk-list-item-xsmall { padding: 0.6rem; }

.tawk-list-item-large { padding: 2.5rem; }

.tawk-loader { position: relative; box-sizing: border-box; display: inline-block; vertical-align: middle; border-radius: 10px; background-color: rgb(84, 84, 84); cursor: default; }

.tawk-loader-bar { width: 100%; height: 1.5rem; }

.tawk-loader-bar-xsmall { width: 100%; height: 0.5rem; }

.tawk-loader-bar-small { width: 100%; height: 1rem; }

.tawk-loader-bar-medium { width: 100%; height: 2rem; }

.tawk-loader-bar-large { width: 100%; height: 2.5rem; }

.tawk-loader-bar-xlarge { width: 100%; height: 3rem; }

.tawk-loader-icon { border-radius: 50%; width: 1.5rem; height: 1.5rem; }

.tawk-loader-icon-xsmall { border-radius: 50%; width: 0.5rem; height: 0.5rem; }

.tawk-loader-icon-small { border-radius: 50%; width: 1rem; height: 1rem; }

.tawk-loader-icon-medium { border-radius: 50%; width: 2rem; height: 2rem; }

.tawk-loader-icon-large { border-radius: 50%; width: 2.5rem; height: 2.5rem; }

.tawk-loader-icon-xlarge { border-radius: 50%; width: 3rem; height: 3rem; }

.tawk-loader-avatar { border-radius: 15px; width: 3rem; height: 3rem; }

.tawk-loader-avatar-xsmall { border-radius: 15px; width: 2rem; height: 2rem; }

.tawk-loader-avatar-small { border-radius: 15px; width: 2.5rem; height: 2.5rem; }

.tawk-loader-avatar-medium { border-radius: 15px; width: 3.5rem; height: 3.5rem; }

.tawk-loader-avatar-large { border-radius: 15px; width: 4rem; height: 4rem; }

.tawk-loader-avatar-xlarge { border-radius: 15px; width: 4.5rem; height: 4.5rem; }

.tawk-loader-animation { animation-duration: 1s; animation-iteration-count: infinite; animation-name: shimmerLeftToRight; animation-timing-function: linear; background: linear-gradient(90deg, rgb(250, 250, 250) 8%, rgb(245, 245, 245) 18%, rgb(250, 250, 250) 33%) 0% 0% / 62.5rem 6.5rem; position: relative; overflow: hidden; animation-fill-mode: forwards !important; }

@keyframes shimmerLeftToRight { 
  0% { background-position: -29.25rem 0px; }
  100% { background-position: 29.25rem 0px; }
}

body.tawk-rtl .tawk-loader-animation { animation-name: shimmerRightToLeft; }

@keyframes shimmerRightToLeft { 
  0% { background-position: 29.25rem 0px; }
  100% { background-position: -29.25rem 0px; }
}

.tawk-overlay { position: fixed; inset: 100% 0px 0px; z-index: 1050; height: 100%; width: 100%; display: flex; flex-direction: column; box-sizing: border-box; background-color: rgb(255, 255, 255); border: 1px solid rgb(233, 233, 233); transition: top 0.3s ease-in-out; overflow: hidden; }

.tawk-overlay.tawk-open { top: 0px; }

.tawk-overlay .tawk-overlay-header { width: 100%; display: flex; align-items: center; box-sizing: border-box; background-color: var(--tawk-header-background-color); padding: 1rem; z-index: 1051; }

.tawk-overlay-header .tawk-overlay-header-left { display: flex; align-items: center; overflow: hidden; }

.tawk-overlay .tawk-overlay-body { flex: 1 1 0%; overflow-y: auto; box-sizing: border-box; }

.tawk-overlay-title { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; font-size: 0.937rem; line-height: 1.618; font-weight: 400; margin-left: 0.6rem; color: var(--tawk-header-text-color); }

.tawk-overlay-header .tawk-button { padding: 0px; height: 1.875rem; width: 2rem; flex: 0 0 auto; background-color: transparent; border: none; transition: background 0.15s ease-in-out; }

.tawk-overlay-header .tawk-button:focus, .tawk-overlay-header .tawk-button:hover { border: none; background-color: rgba(255, 255, 255, 0.2); }

.tawk-phone-input input[type="number"]::-webkit-inner-spin-button, .tawk-phone-input input[type="number"]::-webkit-outer-spin-button { appearance: none; margin: 0px; }

.tawk-phone-input input[type="number"] { }

.tawk-phone-input-wrapper { display: flex; }

.tawk-phone-input-dropdown-button { background-color: rgb(255, 255, 255); border: 1px solid rgb(229, 229, 229); color: rgb(33, 33, 33); padding: 0.6rem; display: flex; align-items: center; height: 40px; }

.tawk-phone-input-wrapper .tawk-dropdown { position: static; }

.tawk-form-wrapper.tawk-phone-input-wrapper .tawk-dropdown { width: auto; }

.tawk-phone-input-dropdown-button, .tawk-phone-input-dropdown-button.tawk-button:not(.tawk-button-text) { border-top-right-radius: 0px; border-bottom-right-radius: 0px; box-shadow: none; }

.tawk-phone-input-wrapper .tawk-dropdown-menu { padding: 0px; width: 100%; max-width: none; }

.tawk-phone-input-dropdown-menu-header { padding: 1rem; }

.tawk-phone-input-wrapper .tawk-input::-webkit-input-placeholder { opacity: 1 !important; }

.tawk-phone-input-wrapper .tawk-input::placeholder { opacity: 1 !important; }

.tawk-phone-input-plus + .tawk-form-wrapper .tawk-input { padding-left: 2rem; border-top-left-radius: 0px; border-bottom-left-radius: 0px; }

.tawk-phone-input-plus { pointer-events: none; position: absolute; top: 0px; bottom: 0px; left: 0px; height: 40px; width: 40px; display: inline-flex; justify-content: center; align-items: center; color: rgb(18, 18, 18); z-index: 2; opacity: 0; }

.tawk-active.tawk-phone-input-plus { opacity: 1; }

.tawk-phone-input-wrapper .tawk-lists { max-height: 200px; overflow-y: auto; }

.tawk-phone-input-wrapper .tawk-lists > .tawk-list-item { cursor: pointer; }

.tawk-phone-input-wrapper .tawk-lists > .tawk-list-item.tawk-active { background-color: rgb(229, 229, 229); }

.tawk-form-input.tawk-phone-input-wrapper .tawk-lists > .tawk-list-item:active, .tawk-form-input.tawk-phone-input-wrapper .tawk-lists > .tawk-list-item:hover, .tawk-phone-input-wrapper .tawk-lists > .tawk-list-item:active, .tawk-phone-input-wrapper .tawk-lists > .tawk-list-item:hover { color: rgb(33, 33, 33) !important; background-color: rgb(229, 229, 229); }

.tawk-form-field-label { color: rgb(18, 18, 18); font: 600 0.812rem Lato, sans-serif; }

body.tawk-rtl .tawk-form-field-label { text-align: right; }

.tawk-radio-container { display: block; position: relative; padding-left: 1.3rem; margin: 1rem; cursor: pointer; user-select: none; }

body.tawk-rtl .tawk-radio-container { padding-left: 0px; padding-right: 2rem; text-align: right; }

.tawk-radio-container .tawk-radio { position: absolute; opacity: 0; cursor: pointer; }

.tawk-radio-container .tawk-checkmark { position: absolute; left: 0px; top: 50%; transform: translateY(-50%); height: 16px; width: 16px; border: 1px solid rgb(84, 84, 84); border-radius: 50%; }

body.tawk-rtl .tawk-radio-container .tawk-checkmark { left: auto; right: 0px; }

.tawk-radio-container .tawk-radio ~ .tawk-checkmark { border: 1px solid rgb(84, 84, 84); }

.tawk-radio-container:hover .tawk-radio ~ .tawk-checkmark { background-color: rgb(250, 250, 250); }

.tawk-radio-container .tawk-radio[disabled] ~ .tawk-checkmark { background: rgb(250, 250, 250); }

.tawk-radio-container .tawk-radio[disabled] { border-color: rgb(84, 84, 84); }

.tawk-radio-container .tawk-radio:checked ~ .tawk-checkmark { background-image: initial; background-position: initial; background-size: initial; background-repeat: initial; background-attachment: initial; background-origin: initial; background-clip: initial; background-color: var(--tawk-header-background-color); border-color: var(--tawk-header-background-color); }

